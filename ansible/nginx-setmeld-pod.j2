    }
}

# Catch-all HTTP server block for any other hostnames/IPs
server {
    listen {{ nginx_port }} default_server;
    server_name _;
    
    # Proxy to SetMeld Pod web interface
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
