{% if enable_https | bool %}
# Initial HTTP-only configuration for SSL certificate acquisition
# This will be automatically updated by Certbot after certificates are obtained

# HTTP server block for the specified domain
server {
    listen 80;
    server_name {{ base_url }};
    
    # Proxy to SetMeld Pod web interface
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Health check
    location /health {
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

# Catch-all HTTP server block for any other hostnames/IPs
server {
    listen 80 default_server;
    server_name _;
    
    # Proxy to SetMeld Pod web interface
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Health check
    location /health {
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

{% else %}
# HTTP server block for the specified domain
